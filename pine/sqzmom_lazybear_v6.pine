// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Rewrite of "Squeeze Momentum Indicator [LazyBear]" in Pine v6 — same logic as the original.
// Concept: John Carter's TTM Squeeze.
//@version=6
indicator("Squeeze Momentum (LazyBear logic)", shorttitle = "SQZMOM", overlay = false)

// ── Inputs ─────────────────────────────────────────────
length       = input.int(20,     "BB Length")
mult         = input.float(2.0,  "BB MultFactor")      // ⚠️ ต้นฉบับประกาศไว้แต่ไม่ได้ใช้
lengthKC     = input.int(20,     "KC Length")
multKC       = input.float(1.5,  "KC MultFactor")
useTrueRange = input.bool(true,  "Use TrueRange (KC)")
src          = close

// ── 1) Bollinger Bands ─────────────────────────────────
basis   = ta.sma(src, length)
dev     = multKC * ta.stdev(src, length)   // ต้นฉบับใช้ multKC ตรงนี้ ไม่ใช่ mult
upperBB = basis + dev
lowerBB = basis - dev

// ── 2) Keltner Channels ────────────────────────────────
ma      = ta.sma(src, lengthKC)
rng     = useTrueRange ? ta.tr : (high - low)
rangema = ta.sma(rng, lengthKC)
upperKC = ma + rangema * multKC
lowerKC = ma - rangema * multKC

// ── 3) สถานะ Squeeze ───────────────────────────────────
sqzOn  = lowerBB > lowerKC and upperBB < upperKC   // BB อยู่ข้างใน KC  → บีบตัว
sqzOff = lowerBB < lowerKC and upperBB > upperKC   // BB ครอบ KC       → ปล่อยตัว
noSqz  = not sqzOn and not sqzOff                  // คาบเกี่ยวกัน

// ── 4) Momentum ────────────────────────────────────────
donchianMid = math.avg(ta.highest(high, lengthKC), ta.lowest(low, lengthKC))
center      = math.avg(donchianMid, ta.sma(close, lengthKC))
val         = ta.linreg(src - center, lengthKC, 0)

// ── 5) สี ──────────────────────────────────────────────
prev   = nz(val[1])
bcolor = val > 0 ? (val > prev ? color.lime : color.green)
                 : (val < prev ? color.red  : color.maroon)
scolor = noSqz ? color.blue : sqzOn ? color.black : color.gray

plot(val, "Momentum", color = bcolor, style = plot.style_histogram, linewidth = 4)
plot(0,   "Squeeze",  color = scolor, style = plot.style_cross,     linewidth = 2)
